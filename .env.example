# 复制成 .env 后填入真实值。.env 不会被提交（见 .gitignore）。

# 火山方舟 API Key（ark- 开头）
ARK_API_KEY=ark-your-key-here

# 火山方舟 OpenAI 兼容地址
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 生成模型 ID（以控制台「开通管理」里显示的 Model ID 为准，注意日期后缀）
ARK_MODEL=glm-5-3-flash-260828

# 查询翻译开关（0/1，默认关）。
#   1 = 中文问题先翻成英文关键词，**只喂给 BM25**（向量路仍用原句）。
#       代价：每次检索多一次模型调用（约 +0.5~1.5s）；此时 L1 需要联网跑，
#       `pytest` 那 110 条也不再是"离线免费"的。
#   0 = 关闭。回归测试与 CI 用这个。
QUERY_TRANSLATION=0
