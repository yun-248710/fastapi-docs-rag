# 复制成 .env 后填入真实值。.env 不会被提交（见 .gitignore）。

# 火山方舟 API Key（ark- 开头）
ARK_API_KEY=ark-your-key-here

# 火山方舟 OpenAI 兼容地址
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 生成模型 ID（以控制台「开通管理」里显示的 Model ID 为准，注意日期后缀）
ARK_MODEL=deepseek-v4-1-flash-economy-261017

# 查询翻译开关（0/1）。代码默认 1（应用侧），pytest 由 conftest.py 强制注入 0。
#   1 = 中文问题先翻成英文关键词，只喂给 BM25（向量路仍用原句）。
#       代价：每次检索多一次模型调用（约 +0.5~1.5s），L1 约 45 → 46/47。
#   0 = 关闭，检索完全走本地。
# 一般不用写这一行；要强制关掉时取消注释：
# QUERY_TRANSLATION=0
